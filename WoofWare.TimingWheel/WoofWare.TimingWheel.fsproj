<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <TargetFramework>net5.0</TargetFramework>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <Authors>PatrickStevens</Authors>
      <Copyright>Copyright (c) Patrick Stevens 2025</Copyright>
      <Description>A timing wheel is a specialized priority queue for a set of time-based alarms.</Description>
      <RepositoryType>git</RepositoryType>
      <RepositoryUrl>https://github.com/Smaug123/WoofWare.TimingWheel</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageIcon>light.png</PackageIcon>
      <PackageTags>timing_wheel;core_kernel;ocaml</PackageTags>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="AssemblyInfo.fs" />
      <Compile Include="Int64.fs" />
      <Compile Include="TimeNs.fs" />
      <Compile Include="NumKeyBits.fs" />
      <Compile Include="LevelBits.fs" />
      <Compile Include="AlarmPrecision.fs" />
      <Compile Include="TimingWheelConfig.fs" />
      <Compile Include="IntervalNumSpan.fs" />
      <Compile Include="IntervalNum.fs" />
      <Compile Include="Key.fs" />
      <Compile Include="ExternalElt.fs" />
      <Compile Include="InternalElt.fs" />
      <Compile Include="Level.fs" />
      <Compile Include="PriorityQueue.fs" />
      <Compile Include="TimingWheel.fsi" />
      <Compile Include="TimingWheel.fs" />
      <EmbeddedResource Include="SurfaceBaseline.txt" />
      <EmbeddedResource Include="../version.json" />
      <None Include="..\logos\light.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="5.0.0" />
    </ItemGroup>

    <!--
      nuget.org renders the packed readme through Markdig with DisableHtml(), which escapes raw
      HTML instead of dropping it, and it does not resolve relative image paths at all. The
      <picture> element that gives GitHub its light/dark logo would therefore appear on the
      package page as literal tags. Pack a copy with that element removed; on nuget.org the logo
      is carried by PackageIcon instead.
    -->
    <Target Name="PackReadmeWithoutLogo" BeforeTargets="_GetPackageFiles">
      <PropertyGroup>
        <_NuGetReadmeDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)nuget-readme</_NuGetReadmeDir>
      </PropertyGroup>
      <MakeDir Directories="$(_NuGetReadmeDir)" />
      <WriteLinesToFile File="$(_NuGetReadmeDir)/README.md"
                        Lines="$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../README.md')), '&lt;picture&gt;[\s\S]*?&lt;/picture&gt;\s*', ''))))"
                        Overwrite="true"
                        WriteOnlyWhenDifferent="true" />
      <!--
        Any other raw HTML would reach nuget.org as escaped tags, so refuse to pack it. The pattern is
        CommonMark's own HTML-block condition (a tag at the start of a line, indented at most three
        spaces), applied after fenced code blocks are removed, so that markup shown as an example
        does not trip it.
      -->
      <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(_NuGetReadmeDir)/README.md')), '(?ms)^```.*?^```', '')), '(?m)^ ? ? ?&lt;[A-Za-z/]'))"
             Text="README.md contains raw HTML other than the &lt;picture&gt; logo element. nuget.org escapes raw HTML rather than rendering it, so that markup would appear on the package page as literal tags: express it in CommonMark instead, or teach the PackReadmeWithoutLogo target to strip it too." />
      <ItemGroup>
        <None Include="$(_NuGetReadmeDir)/README.md" Pack="true" PackagePath="\" />
      </ItemGroup>
    </Target>

</Project>
